{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/assets/(.*).glb", "headers": [
      { "key": "Content-Type", "value": "model/gltf-binary" },
      { "key": "Cache-Control", "value": "public, max-age=86400" },
      { "key": "Access-Control-Allow-Origin", "value": "*" } ] },
    { "source": "/assets/(.*).webp", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
  ]
}
