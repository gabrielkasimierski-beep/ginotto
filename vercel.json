{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/assets/(.*).glb", "headers": [
      { "key": "Content-Type", "value": "model/gltf-binary" },
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
      { "key": "Access-Control-Allow-Origin", "value": "*" } ] },
    { "source": "/assets/(.*)\\.(webp|mp4|png|jpg|svg)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
